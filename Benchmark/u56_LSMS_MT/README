Time:: Start-up         :     1.94400Sec
invertBlockMatrix     :: Using  LU: Block size =   2233,  Time =   19.038 Sec
ie =   1 , Time:     20.44200
invertBlockMatrix     :: Using  LU: Block size =   1675,  Time =   19.054 Sec
Time:: calValenceStates :    41.12500Sec
Time:: computeNewPotential:    0.00200
Time:: Iteration      1 :    41.13800Sec
Time:: Cummulative      :    43.10200Sec
invertBlockMatrix     :: Using  LU: Block size =   2233,  Time =   18.970 Sec
ie =   1 , Time:     20.36800
invertBlockMatrix     :: Using  LU: Block size =   1675,  Time =   19.019 Sec
Time:: calValenceStates :    41.07400Sec
